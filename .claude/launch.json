{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-local",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "app.main:app", "--port", "8000"],
      "env": { "SYNC_ENABLED": "false" },
      "port": 8000
    },
    {
      "name": "api-e2e",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "app.main:app", "--port", "8010"],
      "env": { "SYNC_ENABLED": "false", "RATE_LIMIT_ENABLED": "false" },
      "port": 8010
    },
    {
      "name": "mockups",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--no-project", "python", "-m", "http.server", "8811", "--bind", "127.0.0.1", "--directory", "design/mockups"],
      "port": 8811
    },
    {
      "name": "frontend-local",
      "runtimeExecutable": "C:\\Program Files\\nodejs\\npm.cmd",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "frontend-public",
      "runtimeExecutable": "C:\\Program Files\\nodejs\\npm.cmd",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "env": { "SOL_INDEX_BACKEND": "https://mars-api.sungrazing-menkent.ts.net" },
      "port": 5173
    }
  ]
}
