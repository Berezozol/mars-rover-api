# Copy to .env next to compose.yml (C:\Users\<user>\mars-server\.env) and fill it in.
# Never commit .env. Secrets are empty here on purpose: the stack refuses to start without
# POSTGRES_PASSWORD, and an empty ADMIN_TOKEN keeps the admin API off.
#
# Generate a random value (PowerShell 5.1, 32 random bytes as URL-safe text, one line):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b).TrimEnd('=').Replace('+','-').Replace('/','_')
# or: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Both outputs are safe inside DATABASE_URL; do not use @ : / % # in the DB password.

# --- Required -------------------------------------------------------------------------------

# Password of the `mars` database role. Used by the db container on first start (empty volume)
# and to build DATABASE_URL for the app. Changing it later does NOT change the role password
# in an existing volume (use ALTER ROLE mars PASSWORD '...' in psql as well).
POSTGRES_PASSWORD=

# --- Public address ------------------------------------------------------------------------

# Public origin of the API (the Funnel URL, no trailing slash). MUST be set in production: the app
# then builds links in /developers, /llms.txt, v2 image links and RSS from it and ignores the Host
# header (prevents host-header cache poisoning and leaking the container address).
PUBLIC_BASE_URL=https://<your-funnel-host>

# --- Admin API -----------------------------------------------------------------------------

# Enables /api/v2/admin/* (header X-Admin-Token). Empty = admin off (404).
# To enable, put a generated value here (at least 16 characters, see above).
# Keep it EMPTY while the laptop is only the fallback behind Tailscale Funnel: Funnel cannot
# filter paths (it forwards everything to the app), so the only protection of the admin routes
# is that they do not exist (404). Production is the VPS, where Caddy also closes them
# (deploy/README.md, "Laptop + Tailscale Funnel").
ADMIN_TOKEN=

# --- Alerts to Telegram (optional) ---------------------------------------------------------
# Leave commented out to disable application alerts. How to get them: deploy/README.md,
# "Monitoring". The bot token is a secret: anyone holding it controls the bot.
# TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-BotFather
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_API_BASE=https://api.telegram.org
# Minutes between alert checks (failed sync, stale data)
# ALERT_CHECK_INTERVAL_MINUTES=60

# --- Optional tuning (application defaults shown) ------------------------------------------
# Uncomment only what you change. A commented variable is not passed to the container.

# LOG_LEVEL=INFO
# SYNC_INTERVAL_MINUTES=360
# Data freshness thresholds for /health/sync and alerts
# SYNC_STALE_HOURS=24
# PHOTOS_STALE_DAYS=21
# HEALTH_SYNC_CACHE_SECONDS=30
# Per-IP rate limit for /api/v1, /mars-photos/api/v1, /api/v2; the other paths the app serves
# (/docs, /developers, the web interface, ...) have only a concurrency limit, RATE_LIMIT_PAGE_CONCURRENT
# IPv6 clients are counted per /64 (one subscriber) and, with a budget this many times larger
# than one client's, per /48 (one customer's whole allocation); a request counts in both.
# Wrong tokens/keys, e-mails and heavy searches are counted per /48.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=2000
# RATE_LIMIT_IPV6_SITE_FACTOR=8
# Server-wide ceiling for open connections plus requests in flight: above it uvicorn answers
# 503 "Service Unavailable" (text/plain). The image default is 384 (Funnel has no
# connection cap of its own); this file reaches the container as is. Read by uvicorn itself.
# UVICORN_LIMIT_CONCURRENCY=384
# Wrong admin tokens per IP before admin requests from it get 429 for the window
# ADMIN_AUTH_MAX_FAILURES=10
# ADMIN_AUTH_WINDOW_MINUTES=15
# CORS_ORIGINS=["*"]
# UPSTREAM_USER_AGENT=mars-rover-api/0.1 (personal project)
# Full-size Spirit/Opportunity images: converted from NASA PDS .img to JPEG on request and
# cached on disk (volume mer_images, mounted at /app/data/mer-images; leave the directory as is).
# The cache can be deleted at any time, images are converted again when requested.
# MER_IMAGE_CACHE_DIR=data/mer-images
# Cache size limit in MB (5120 = 5 GB); the oldest files are removed above it
# MER_IMAGE_CACHE_MAX_MB=5120
# Simultaneous conversions (CPU and memory) and time limit of one conversion
# MER_CONVERT_CONCURRENCY=2
# MER_CONVERT_TIMEOUT_SECONDS=60
# Conversions waiting for a free slot; above it the request gets 503 (default 8)
# MER_CONVERT_QUEUE=8
# Requests per second to NASA PDS from all conversions together (default 2)
# MER_PDS_MAX_RPS=2
# Rover locations from MMGIS (stage 11): refreshed after the photo sync at most once a day
# LOCATION_SYNC_ENABLED=true
# LOCATION_BASE_URL=https://mars.nasa.gov/mmgis-maps/
# LOCATION_REFRESH_HOURS=24
# Alert in Telegram when a file has not been checked successfully for this many days
# LOCATION_STALE_DAYS=3
# Perseverance samples from the NASA "Mars Rock Samples" page (stage 13): checked at most once a day
# SAMPLES_SYNC_ENABLED=true
# SAMPLES_URL=https://science.nasa.gov/mission/mars-2020-perseverance/mars-rock-samples/
# SAMPLES_REFRESH_HOURS=24
# SAMPLES_MAX_BYTES=4194304
# SAMPLES_STALE_DAYS=3
# Upstream feeds (change only for the alert test, see deploy/README.md)
# M2020_FEED_URL=https://mars.nasa.gov/rss/api/
# MSL_FEED_URL=https://mars.nasa.gov/api/v1/raw_image_items/

# Fixed in compose.yml, setting them here has no effect:
# DATABASE_URL, ENVIRONMENT=prod, FORWARDED_ALLOW_IPS, SYNC_ENABLED=true
