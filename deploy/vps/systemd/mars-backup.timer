[Unit]
Description=Weekly database backup of the Mars Rover API

[Timer]
# Sunday 02:30 UTC, before the restore test (03:30); the nightly reboot of unattended-upgrades is at 05:00 UTC.
OnCalendar=Sun *-*-* 02:30:00 UTC
RandomizedDelaySec=5min
# Run at boot if the machine was off at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
