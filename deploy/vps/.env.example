# Copy to /srv/mars/.env on the server (chmod 600) and fill it in. Never commit .env.
# Secrets are empty here on purpose: the stack refuses to start without APP_DB_PASSWORD, and
# an empty ADMIN_TOKEN keeps the admin API off.
# The password of the schema owner `mars` is NOT here: it is the file
# /srv/mars/secrets/pg_owner_password (deploy/README.md, install step 2), so that the
# application container, which receives this whole file, never holds it.
#
# Generate a random value (on the server):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# or: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
# Both outputs are safe inside DATABASE_URL; do not use @ : / % # in the DB password.

# --- Required -------------------------------------------------------------------------------

# Password of the restricted role `mars_app` (SELECT/INSERT/UPDATE/DELETE only) that the
# running application uses. db-roles.sql creates the role on the first start and sets this
# password on every update.sh run, so rotating it = edit here, run update.sh.
APP_DB_PASSWORD=

# Image tag of the app (mars-rover-api:<tag>). Written by update.sh; do not edit by hand
# except for a rollback (README, "Update and rollback").
APP_TAG=

# --- Public address ------------------------------------------------------------------------

# Public origin of the API, no trailing slash. MUST be set in production: the app builds
# absolute links from it (v2 image links, RSS, /developers, /llms.txt) and ignores the Host
# header (prevents host-header cache poisoning). Only ONE origin can be configured while the
# server answers on two hosts: the links are for API clients, so it is the API host.
# Sol Index (solindex.net) uses same-origin relative URLs and is not affected.
PUBLIC_BASE_URL=https://api.solindex.net

# Browsers on other sites may call the public read API; Sol Index itself is same-origin.
# Default of the application is all origins (admin is protected by the token, not by CORS).
# CORS_ORIGINS=["*"]

# --- Reverse proxy -------------------------------------------------------------------------

# Peers whose X-Forwarded-* uvicorn trusts. The default of compose.yml is the gateway of the
# fixed subnet 172.28.0.0/24 (172.28.0.1); override only with the exact peer address that the
# rehearsal shows (deploy/README.md, "Checks after a rollout"). Never "*" or a wide range.
# FORWARDED_ALLOW_IPS=172.28.0.1

# --- Image pins ----------------------------------------------------------------------------

# Pin the third-party images by digest on install (deploy/README.md, "Pin images"): replace
# <pin-on-install> with the digest printed on the server, uncomment, run update.sh.
# CADDY_IMAGE=caddy:2.10-alpine@sha256:<pin-on-install>
# POSTGRES_IMAGE=postgres:16.16-alpine@sha256:<pin-on-install>

# --- Scheduler -----------------------------------------------------------------------------

# true on exactly ONE instance. With more app replicas: true on one, false on the others.
SYNC_ENABLED=true

# --- Admin API -----------------------------------------------------------------------------

# Enables /api/v2/admin/* (header X-Admin-Token) for requests that reach 127.0.0.1:8000, i.e.
# through the SSH tunnel; Caddy answers 404 for it on the public hosts. Empty = admin off.
# To enable, put a generated value here (at least 16 characters, see above).
ADMIN_TOKEN=

# --- Alerts to Telegram (optional) ---------------------------------------------------------
# Application alerts (failed sync, stale data) AND the host alerts of host-check.sh/backup.sh
# use the same bot and chat. Leave commented out to disable both. How to get them:
# deploy/README.md, "Monitoring". The bot token is a secret.
# TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-BotFather
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_API_BASE=https://api.telegram.org
# ALERT_CHECK_INTERVAL_MINUTES=60

# --- Backups (optional off-server copy) ----------------------------------------------------
# The main off-server copy is pulled by the owner's computer (deploy/vps/pull-backup.ps1) and
# needs nothing here. Optional extra: rclone destination for the daily dump, e.g.
# "myremote:mars-backups". Empty/unset: no upload (local copies only, 7 newest). Requires
# rclone installed and `rclone config` done as the deploy user. Not read by the application.
# BACKUP_REMOTE=

# --- Optional application tuning (defaults shown; see deploy/laptop/.env.example) ----------
# Uncomment only what you change. A commented variable is not passed to the container.
# LOG_LEVEL=INFO
# SYNC_INTERVAL_MINUTES=360
# SYNC_STALE_HOURS=24
# PHOTOS_STALE_DAYS=21
# Per-IP limit on /api/v1, /mars-photos/api/v1, /api/v2 only. The other paths the app serves
# (/docs, /openapi.json, /developers, /llms.txt, /health) have the concurrency limit
# RATE_LIMIT_PAGE_CONCURRENT; the web interface files are served by Caddy. Connections per
# address are limited by nftables (README "Edge limits").
# IPv6 clients are counted per /64 (one subscriber) and, with a budget this many times larger
# than one client's, per /48 (one customer's whole allocation); a request counts in both.
# Wrong tokens/keys, e-mails and heavy searches are counted per /48.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=2000
# RATE_LIMIT_IPV6_SITE_FACTOR=8
# Concurrent requests per address on the non-API paths that reach the app (/docs, /openapi.json,
# /developers, ...); the web interface files are served by Caddy. Default 16.
# RATE_LIMIT_PAGE_CONCURRENT=16
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# Server-wide ceiling for open connections plus requests in flight: above it uvicorn answers
# 503 "Service Unavailable" (text/plain) before the application sees the request. Caddy does
# not cap its connections to the app, so this is the only ceiling (web interface files are
# served by Caddy and do not count). Default 384, see README, "Edge limits". Read by uvicorn.
# UVICORN_LIMIT_CONCURRENCY=384
# MER_IMAGE_CACHE_MAX_MB=5120
# MER_CONVERT_CONCURRENCY=2

# Fixed in compose.yml, setting them here has no effect: DATABASE_URL, ENVIRONMENT=prod.
# Do not put the owner password or POSTGRES_PASSWORD here: this file goes into the app container.
