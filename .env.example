# Copy to .env and adjust. The .env file is never committed.

# Local Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgresql+asyncpg://mars:mars@localhost:5433/mars
TEST_DATABASE_URL=postgresql+asyncpg://mars:mars@localhost:5433/mars_test

LOG_LEVEL=INFO
ENVIRONMENT=dev

# Background sync of upstream feeds (stage 3)
SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=360
SYNC_OVERLAP_SOLS=7
# Sols per chunk: a sync range is fetched in chunks, each sol is committed at once
SYNC_CHUNK_SOLS=10
# Sols per backfill batch (python -m app.cli backfill); each batch is one sync run
BACKFILL_BATCH_SOLS=100
# Rover locked by another sync: retry every N seconds, give up (exit 2) after M seconds
BACKFILL_LOCK_RETRY_SECONDS=30
BACKFILL_LOCK_MAX_WAIT_SECONDS=600
# Stop (exit 1) after this many consecutive batches whose sync run failed; rerun resumes
BACKFILL_MAX_FAILED_BATCHES=3

# RSS feed of new photos (stage 16): only photos stored by the sync in the last N days
FEED_WINDOW_DAYS=30

# Upstream (JPL raw image feeds)
UPSTREAM_TIMEOUT_SECONDS=30
UPSTREAM_MAX_RPS=1.0
UPSTREAM_USER_AGENT=mars-rover-api/0.1 (personal project; contact via GitHub)
# Retries after the first attempt; backoff = base * 2**retry_index, capped at 30 s
UPSTREAM_MAX_RETRIES=4
UPSTREAM_RETRY_BASE_SECONDS=1.0
# Safety cap on pages per fetch (per sol for Curiosity, per sol range for Perseverance)
UPSTREAM_MAX_PAGES=200
M2020_FEED_URL=https://mars.nasa.gov/rss/api/
MSL_FEED_URL=https://mars.nasa.gov/api/v1/raw_image_items/
# Perseverance feed caps num at 100 (values above 100 are rejected)
M2020_PAGE_SIZE=100
MSL_PAGE_SIZE=200

# Spirit/Opportunity (stage 8): PDS index files are downloaded once (`mer-download`) into
# MER_CACHE_DIR, then imported offline (`import-mer`). Image and product links use the base URL.
MER_PDS_BASE_URL=https://planetarydata.jpl.nasa.gov/img/data/mer/
MER_CACHE_DIR=data/mer

# Full-size Spirit/Opportunity frames (stage 9a): the PDS3 .img is downloaded, converted to JPEG
# and kept in this disk cache (oldest-accessed files are evicted above the size limit).
MER_IMAGE_CACHE_DIR=data/mer-images
MER_IMAGE_CACHE_MAX_MB=5120

MER_CONVERT_CONCURRENCY=2
MER_CONVERT_TIMEOUT_SECONDS=60
MER_CONVERT_QUEUE=8
MER_PDS_MAX_RPS=2

# Rover positions (stage 11): MMGIS waypoint and traverse files of Perseverance and Curiosity,
# loaded at the end of the scheduled sync (needs SYNC_ENABLED=true), at most once per refresh period
LOCATION_SYNC_ENABLED=true
LOCATION_BASE_URL=https://mars.nasa.gov/mmgis-maps/
LOCATION_REFRESH_HOURS=24
LOCATION_MAX_BYTES=16777216
# A new file with fewer rows than this share of the stored ones is rejected (CLI --force overrides)
LOCATION_MIN_KEEP_RATIO=0.9
# Alert when no check of a location file succeeded for this many days
LOCATION_STALE_DAYS=3

# Perseverance samples (stage 13): the table of the NASA "Mars Rock Samples" page, checked at the
# end of the scheduled sync (needs SYNC_ENABLED=true) at most once per refresh period
SAMPLES_SYNC_ENABLED=true
SAMPLES_URL=https://science.nasa.gov/mission/mars-2020-perseverance/mars-rock-samples/
SAMPLES_REFRESH_HOURS=24
SAMPLES_MAX_BYTES=4194304
# Alert when no check of the samples page succeeded for this many days
SAMPLES_STALE_DAYS=3

# Sol Index web interface build (stage 10), served at / when index.html exists there.
# A relative path is resolved against the project root.
FRONTEND_DIST_DIR=frontend/dist

# Origin substituted for a malformed Host header (absolute links, /developers, /llms.txt).
# When set it is always used and the Host header is ignored; empty: a valid Host is used, else http://localhost.
PUBLIC_BASE_URL=

# Admin endpoints (/api/v2/admin/...) exist only when ADMIN_TOKEN is set; clients send it
# in the X-Admin-Token header. Leave empty to disable them. Use a long random value
# (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"), never commit it.
ADMIN_TOKEN=

# JSON list of allowed origins for browsers
CORS_ORIGINS=["*"]

# Per-IP request limit on /api/v1, /mars-photos/api/v1 and /api/v2 (stage 9). Both windows
# apply; over either one the API answers 429 with Retry-After. Counters live in memory.
# Behind a proxy the client IP comes from X-Forwarded-For only for FORWARDED_ALLOW_IPS (uvicorn).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=2000
# After this many 401s from one IP within the window, admin answers 429 to that IP
# (even with the right token) until the window frees up
ADMIN_AUTH_MAX_FAILURES=10
ADMIN_AUTH_WINDOW_MINUTES=15

# Freshness (/health/sync, alerts): a rover is stale when its last successful sync is older
# than SYNC_STALE_HOURS or its newest photo is older than PHOTOS_STALE_DAYS
SYNC_STALE_HOURS=24
PHOTOS_STALE_DAYS=21
# /health/sync caches its result in memory for this many seconds (0 = no cache)
HEALTH_SYNC_CACHE_SECONDS=30

# Telegram alerts (stale data, failed or partial syncs); enabled only when both the bot
# token and the chat id are set. The token is a secret: never commit it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
# How often the freshness is checked (independent of SYNC_ENABLED)
ALERT_CHECK_INTERVAL_MINUTES=60
